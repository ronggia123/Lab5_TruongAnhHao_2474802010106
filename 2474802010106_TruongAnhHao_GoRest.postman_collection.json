  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {\n    pm.response.to.have.status(201);\n});\n\nvar jsonData = pm.response.json();\nif (jsonData && jsonData.id) {\n    pm.environment.set(\"userId\", jsonData.id);\n}\n\nlet users = JSON.parse(pm.collectionVariables.get(\"usersList\") || \"[]\");\nlet index = parseInt(pm.collectionVariables.get(\"currentIndex\")) || 0;\nindex++;\npm.collectionVariables.set(\"currentIndex\", index);\n\nif (index < users.length) {\n    postman.setNextRequest(\"Create User\");\n} else {\n    // Khi chạy xong 3 user, xóa biến tạm và chuyển sang GET User\n    pm.collectionVariables.unset(\"currentIndex\");\n    pm.collectionVariables.unset(\"usersList\");\n    postman.setNextRequest(\"GET User\");\n}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let usersStr = pm.collectionVariables.get(\"usersList\");\nlet users;\n\nif (!usersStr) {\n    // Tạo mã thời gian ngẫu nhiên để đảm bảo email luôn là duy nhất không bị lỗi 422\n    let uniqueId = Date.now();\n    users = [\n        { name: \"Nguyen Van A\", gender: \"male\", email: `nguyenvana_${uniqueId}_1@gmail.com`, status: \"active\" },\n        { name: \"Tran Thi B\", gender: \"female\", email: `tranthib_${uniqueId}_2@gmail.com`, status: \"active\" },\n        { name: \"Le Van C\", gender: \"male\", email: `levanc_${uniqueId}_3@gmail.com`, status: \"active\" }\n    ];\n    pm.collectionVariables.set(\"usersList\", JSON.stringify(users));\n    pm.collectionVariables.set(\"currentIndex\", 0);\n    usersStr = pm.collectionVariables.get(\"usersList\");\n}\n\nusers = JSON.parse(usersStr);\nlet index = parseInt(pm.collectionVariables.get(\"currentIndex\")) || 0;\n\nif (index < users.length) {\n    let currentUser = users[index];\n    pm.collectionVariables.set(\"name\", currentUser.name);\n    pm.collectionVariables.set(\"gender\", currentUser.gender);\n    pm.collectionVariables.set(\"email\", currentUser.email);\n    pm.collectionVariables.set(\"status\", currentUser.status);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"gender\": \"{{gender}}\",\n  \"email\": \"{{email}}\",\n  \"status\": \"{{status}}\"\n}",
