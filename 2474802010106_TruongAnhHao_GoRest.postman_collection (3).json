    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.id) {",
                  "    pm.environment.set(\"userId\", jsonData.id);",
                  "}",
                  "",
                  "postman.setNextRequest(\"GET User\");"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let uniqueId = Date.now() + \"_\" + Math.floor(Math.random() * 10000);",
                  "let rawEmail = pm.iterationData.get(\"email\") || \"user@example.com\";",
                  "let emailParts = rawEmail.split(\"@\");",
                  "let uniqueEmail = emailParts[0] + \"_\" + uniqueId + \"@\" + emailParts[1];",
                  "",
                  "pm.collectionVariables.set(\"name\", pm.iterationData.get(\"name\"));",
                  "pm.collectionVariables.set(\"gender\", pm.iterationData.get(\"gender\"));",
                  "pm.collectionVariables.set(\"email\", uniqueEmail);",
                  "pm.collectionVariables.set(\"status\", pm.iterationData.get(\"status\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"gender\": \"{{gender}}\",\n  \"email\": \"{{email}}\",\n  \"status\": \"{{status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://gorest.co.in/public/v2/users",
              "protocol": "https",
              "host": [
                "gorest",
